# ============================================================
#  Token-Sentry — Environment Variables Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to Git.
# ============================================================

# --- Groq AI ---
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# --- Models ---
# Main model for user conversations
GROQ_MAIN_MODEL=llama-3.3-70b-versatile
# Fast/cheap model used for internal summarization
GROQ_SUMMARIZER_MODEL=llama-3.1-8b-instant

# --- Token Watermark ---
TOKEN_HIGH_WATERMARK=4000
HOT_BUFFER_TURNS=3

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Google Cloud (for future production deployment) ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1

# --- App Settings ---
ENV=development
LOG_LEVEL=INFO
PORT=8000
